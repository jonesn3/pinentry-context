#!/usr/bin/env python3
"""pinentry-context: show *what is asking* in GPG and SSH passphrase popups.

Modes
  pinentry-context [pinentry args]
      Pinentry proxy. Set as `pinentry-program` in gpg-agent.conf. Appends the
      requesting process chain to the prompt, then defers to the real pinentry.

  ssh-askpass-context PROMPT          (a symlink to this file)
      SSH askpass wrapper. Point SSH_ASKPASS at the symlink. Appends the
      requesting process chain to the prompt, then defers to the real askpass.

  pinentry-context --describe PID
      Print the context that would be shown for PID.

Optional config: ~/.config/pinentry-context/config  (key = value)
  pinentry = /usr/bin/pinentry-qt       real pinentry to run
  askpass  = /usr/bin/ksshaskpass       real askpass to run
  notify   = swaynag -t warning -m      command for "touch your security key"
                                        notices; the message is appended
  stop     = myterm, otherwise          extra process names to end the chain at
  title_command = my-title-script       prints the window title for the pids
                                        given as arguments (nearest first)
"""
import os
import shlex
import subprocess
import sys

PINENTRY_CANDIDATES = [
    "/usr/bin/pinentry", "/usr/local/bin/pinentry", "/opt/homebrew/bin/pinentry",
    "/usr/bin/pinentry-gnome3", "/usr/bin/pinentry-qt", "/usr/bin/pinentry-gtk-2",
    "/usr/bin/pinentry-curses",
]
ASKPASS_CANDIDATES = [
    "/usr/libexec/openssh/gnome-ssh-askpass",   # Fedora / RHEL
    "/usr/lib/openssh/gnome-ssh-askpass",       # Debian / Ubuntu
    "/usr/lib/ssh/gnome-ssh-askpass3",          # Arch
    "/usr/bin/ksshaskpass",
    "/usr/lib/ssh/ksshaskpass",
    "/usr/bin/lxqt-openssh-askpass",
    "/usr/lib/ssh/x11-ssh-askpass",
    "/usr/libexec/openssh/ssh-askpass",
    "/usr/lib/ssh/ssh-askpass",
    "/usr/bin/ssh-askpass",
]
# Session/terminal processes: the chain is cut here, nothing above is useful.
STOP = {
    "systemd", "init", "login", "sshd", "sway", "Hyprland", "river", "niri",
    "gnome-shell", "plasmashell", "kwin_wayland", "i3", "tmux: server", "screen",
    "foot", "footclient", "alacritty", "kitty", "wezterm-gui", "ghostty",
    "gnome-terminal-", "konsole", "xterm", "ptyxis", "kgx", "tilix", "terminator",
}
SHELLS = {"bash", "sh", "zsh", "fish", "dash", "ksh", "nu"}
MAX_DEPTH = 8


def load_config():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    conf = {}
    try:
        with open(os.path.join(base, "pinentry-context", "config")) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    key, value = line.split("=", 1)
                    conf[key.strip()] = value.strip()
    except OSError:
        pass
    return conf


def find_backend(configured, candidates):
    me = os.path.realpath(__file__)
    for path in ([os.path.expanduser(configured)] if configured else []) + candidates:
        if os.access(path, os.X_OK) and os.path.realpath(path) != me:
            return path
    return None


def proc(pid):
    with open(f"/proc/{pid}/stat") as f:
        stat = f.read()
    comm = stat[stat.index("(") + 1:stat.rindex(")")]
    ppid = int(stat[stat.rindex(")") + 2:].split()[1])
    with open(f"/proc/{pid}/cmdline", "rb") as f:
        cmd = f.read().replace(b"\0", b" ").decode(errors="replace")
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        cwd = None
    return comm, ppid, " ".join(cmd.split()) or comm, cwd


def describe(pid, conf=None):
    conf = conf or {}
    stop = set(STOP)
    if conf.get("stop"):
        stop |= {s.strip() for s in conf["stop"].split(",") if s.strip()}
    home = os.path.expanduser("~")
    chain, pids, cwd = [], [], None
    while pid > 1 and len(chain) < MAX_DEPTH:
        try:
            comm, ppid, cmd, pcwd = proc(pid)
        except (OSError, ValueError):
            break
        pids.append(pid)
        if comm in stop:
            chain.append(f"[{comm}]")
            break
        if cwd is None:
            cwd = pcwd
        # "bash -c <long script>" wrappers are noise; keep them short
        limit = 50 if comm in SHELLS else 90
        if len(cmd) > limit:
            cmd = cmd[:limit - 1] + "…"
        chain.append(f"{cmd}  ({pid})")
        pid = ppid
    if not chain:
        return "Requested by: unknown process"
    if cwd and (cwd == home or cwd.startswith(home + "/")):
        cwd = "~" + cwd[len(home):]
    lines = []
    title = window_title(pids, conf)
    if title:
        lines.append(f"Window: {title}")
    lines.append(f"Requested from: {cwd or '?'}")
    # outermost first, the direct requester last
    for depth, entry in enumerate(reversed(chain)):
        lines.append("  " * depth + ("└ " if depth else "") + entry)
    return "\n".join(lines)


# --- Window title lookup ------------------------------------------------------
#
# A provider answers "which window does this request come from?" for one window
# manager / desktop. To support another one, add a function below:
#
#   @title_provider
#   def mywm_title(pids):
#       ...
#
# `pids` is the requesting process chain, nearest first, ending at the terminal
# (or wherever the chain stopped). Return the window title as a string, or None
# if this provider does not apply (other desktop, no matching window). Providers
# are tried in order; exceptions count as "does not apply", so an unsupported
# desktop simply gets no "Window:" line. Keep them fast (<1s): the passphrase
# prompt waits for them.

TITLE_PROVIDERS = []
TITLE_MAX = 80
TITLE_TIMEOUT = 1.0     # seconds


def title_provider(func):
    TITLE_PROVIDERS.append(func)
    return func


def window_title(pids, conf):
    """Title of the window the request comes from, or None."""
    def clean(title):
        title = "".join(c for c in (title or "") if c.isprintable()).strip()
        if len(title) > TITLE_MAX:
            title = title[:TITLE_MAX - 1] + "…"
        return title or None

    if conf.get("title_command"):       # user hook: gets the pids as arguments
        try:
            out = subprocess.run(
                shlex.split(conf["title_command"]) + [str(p) for p in pids],
                capture_output=True, text=True, timeout=TITLE_TIMEOUT,
                stdin=subprocess.DEVNULL).stdout
            title = clean(out.split("\n", 1)[0])
            if title:
                return title
        except Exception:
            pass
    for provider in TITLE_PROVIDERS:
        try:
            title = clean(provider(pids))
            if title:
                return title
        except Exception:
            pass
    return None


@title_provider
def sway_title(pids):
    """sway: ask the compositor for its window tree over the IPC socket."""
    import glob
    import json
    import socket
    import struct
    path = os.environ.get("SWAYSOCK")
    if not path or not os.path.exists(path):
        found = glob.glob(f"/run/user/{os.getuid()}/sway-ipc.*.sock")
        if not found:
            return None
        path = found[0]

    def read(sock, size):
        data = b""
        while len(data) < size:
            chunk = sock.recv(size - len(data))
            if not chunk:
                raise EOFError
            data += chunk
        return data

    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(TITLE_TIMEOUT)
        sock.connect(path)
        sock.sendall(b"i3-ipc" + struct.pack("=II", 0, 4))      # 4 = GET_TREE
        length = struct.unpack("=II", read(sock, 14)[6:])[0]
        tree = json.loads(read(sock, length))

    windows = {}                        # pid -> title (focused one wins)

    def walk(node):
        pid, name = node.get("pid"), node.get("name")
        if pid and name and (pid not in windows or node.get("focused")):
            windows[pid] = name
        for child in node.get("nodes", []) + node.get("floating_nodes", []):
            walk(child)

    walk(tree)
    for pid in pids:                    # nearest process that owns a window
        if pid in windows:
            return windows[pid]
    return None


GIT_OPTS_WITH_VALUE = {"-C", "-c", "--git-dir", "--work-tree", "--namespace",
                       "--config-env", "--super-prefix"}
GIT_MSG_FILES = {"commit": "COMMIT_EDITMSG", "tag": "TAG_EDITMSG"}
MSG_MAX_AGE = 60        # seconds; older message files belong to an earlier run
SUBJECT_MAX = 100


def git_subcommand(argv):
    """Return (subcommand, its arguments) for a git command line."""
    i = 1
    while i < len(argv):
        if argv[i] in GIT_OPTS_WITH_VALUE:
            i += 2
        elif argv[i].startswith("-"):
            i += 1
        else:
            return argv[i], argv[i + 1:]
    return None, []


def find_git_dir(pid, cwd):
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            for item in f.read().split(b"\0"):
                if item.startswith(b"GIT_DIR="):
                    return os.path.join(cwd, os.fsdecode(item[8:]))
    except OSError:
        pass
    path = cwd
    while True:
        dotgit = os.path.join(path, ".git")
        if os.path.isdir(dotgit):
            return dotgit
        if os.path.isfile(dotgit):          # worktree / submodule: "gitdir: <path>"
            with open(dotgit) as f:
                first = f.readline().strip()
            if first.startswith("gitdir:"):
                return os.path.join(path, first[7:].strip())
        parent = os.path.dirname(path)
        if parent == path:
            return None
        path = parent


def clean_subject(text):
    for line in text.splitlines():
        line = "".join(c for c in line if c.isprintable()).strip()
        if line and not line.startswith("#"):
            return line if len(line) <= SUBJECT_MAX else line[:SUBJECT_MAX - 1] + "…"
    return None


def git_message(sub, args, pid, cwd):
    """Subject of the message git is about to sign, or None if unknown."""
    import time
    git_dir = find_git_dir(pid, cwd) if cwd else None
    if git_dir:
        path = os.path.join(git_dir, GIT_MSG_FILES[sub])
        try:
            if time.time() - os.stat(path).st_mtime < MSG_MAX_AGE:
                with open(path, errors="replace") as f:
                    subject = clean_subject(f.read(4096))
                if subject:
                    return subject
        except OSError:
            pass
    # `git tag -m` writes no message file; fall back to the command line
    for i, arg in enumerate(args):
        if arg in ("-m", "--message") and i + 1 < len(args):
            return clean_subject(args[i + 1])
        if arg.startswith("--message="):
            return clean_subject(arg[10:])
        if arg.startswith("-m") and len(arg) > 2:
            return clean_subject(arg[2:])
    return None


def git_headline(pid):
    """One line saying what git is signing, if the requester is a git command.

    Only meaningful for GPG requests: gpg is asked to sign by `git commit`,
    `git tag`, or a command that creates commits (rebase, merge, ...).
    """
    for _ in range(MAX_DEPTH):
        if pid <= 1:
            break
        try:
            comm, ppid, _cmd, cwd = proc(pid)
            if comm == "git":
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    argv = [os.fsdecode(a) for a in f.read().split(b"\0") if a]
                sub, args = git_subcommand(argv)
                if sub in GIT_MSG_FILES:
                    subject = git_message(sub, args, pid, cwd)
                    if subject:
                        return f"Signing {sub}: “{subject}”"
                    return f"Signing a git {sub} (message not available)"
                if sub:
                    return f"Signing for: git {sub}"
        except (OSError, ValueError):
            break
        pid = ppid
    return None


def assuan_escape(text):
    return text.replace("%", "%25").replace("\r", "").replace("\n", "%0A").encode()


def run_pinentry(conf):
    real = find_backend(
        os.environ.get("PINENTRY_CONTEXT_REAL") or conf.get("pinentry"),
        PINENTRY_CANDIDATES)
    if not real:
        sys.stderr.write("pinentry-context: no real pinentry found\n")
        sys.exit(1)
    try:
        # The child writes its replies straight to gpg-agent; only the
        # agent -> pinentry direction passes through us.
        child = subprocess.Popen([real] + sys.argv[1:], stdin=subprocess.PIPE)
    except Exception:
        os.execv(real, [real] + sys.argv[1:])
    owner = None
    try:
        for line in sys.stdin.buffer:
            try:
                if line.startswith(b"OPTION owner="):
                    owner = int(line[13:].split(b"/")[0].split()[0])
                elif line.startswith(b"SETDESC ") and owner:
                    line = add_context(line, owner, conf)
            except Exception:
                pass                      # never let decoration break a prompt
            child.stdin.write(line)
            child.stdin.flush()
    except BrokenPipeError:
        pass
    finally:
        try:
            child.stdin.close()
        except OSError:
            pass
    sys.exit(child.wait())


def add_context(line, owner, conf):
    body = line.rstrip(b"\r\n")
    try:
        headline = git_headline(owner)
    except Exception:
        headline = None
    if headline:                          # goes above gpg's own text
        body = b"SETDESC " + assuan_escape(headline) + b"%0A%0A" + body[8:]
    room = 990 - len(body)                # Assuan lines are limited to 1000 bytes
    if room < 40:
        return line
    extra = (b"%0A%0A" + assuan_escape(describe(owner, conf)))[:room]
    extra = extra.decode(errors="ignore").encode()   # no split UTF-8 sequence
    while b"%" in extra[-2:]:                        # no split %XX escape
        extra = extra[:extra.rindex(b"%")]
    return body + extra + b"\n"


def run_askpass(conf):
    prompt = sys.argv[1] if len(sys.argv) > 1 else "Enter passphrase"
    try:
        context = describe(os.getppid(), conf)
    except Exception:
        context = ""
    # SSH_ASKPASS_PROMPT=none: an informational notice (e.g. "touch your
    # security key"); ssh kills us when it is no longer needed.
    if os.environ.get("SSH_ASKPASS_PROMPT") == "none" and conf.get("notify"):
        cmd = shlex.split(conf["notify"])
        requester = context.splitlines()[-1].strip(" └") if context else ""
        os.execvp(cmd[0], cmd + [f"{prompt} — {requester}" if requester else prompt])
    real = find_backend(
        os.environ.get("SSH_ASKPASS_CONTEXT_REAL") or conf.get("askpass"),
        ASKPASS_CANDIDATES)
    if not real:
        sys.stderr.write("pinentry-context: no real ssh-askpass found; "
                         "set 'askpass' in the config file\n")
        sys.exit(1)
    os.execv(real, [real, f"{prompt}\n\n{context}" if context else prompt])


def main():
    conf = load_config()
    if len(sys.argv) == 3 and sys.argv[1] == "--describe":
        print(describe(int(sys.argv[2]), conf))
    elif "askpass" in os.path.basename(sys.argv[0]):
        run_askpass(conf)
    else:
        run_pinentry(conf)


if __name__ == "__main__":
    main()
